{
  "type": "object",
  "required": [
    "type",
    "characterId",
    "actionId",
    "sceneId",
    "title",
    "backgroundId",
    "characters",
    "lines",
    "interactionOptions",
    "resultText",
    "memoryUpdate",
    "affectionDelta",
    "trustDelta",
    "stageBefore",
    "stageAfter"
  ],
  "properties": {
    "type": { "const": "visual_novel_scene" },
    "characterId": { "type": "string" },
    "actionId": { "type": "string" },
    "sceneId": { "type": "string" },
    "title": { "type": "string" },
    "backgroundId": { "type": "string" },
    "backgroundPath": { "type": "string" },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["characterId", "displayName", "portraitId", "portraitPath"]
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lineType", "speakerId", "speakerName", "text", "expression"],
        "properties": {
          "lineType": { "enum": ["narration", "npc", "player"] },
          "expression": { "enum": ["neutral", "calm", "happy", "sad", "angry", "surprised"] }
        }
      }
    },
    "interactionOptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["optionId", "text", "affectionDelta", "resultText"],
        "properties": {
          "optionId": { "type": "string" },
          "text": { "type": "string" },
          "affectionDelta": { "enum": [0, 1, 3] },
          "resultText": { "type": "string" }
        }
      }
    },
    "resultText": { "type": "string" },
    "memoryUpdate": { "type": "string" },
    "affectionDelta": { "type": "integer" },
    "trustDelta": { "type": "integer" },
    "stageBefore": { "type": "string" },
    "stageAfter": { "type": "string" }
  }
}
